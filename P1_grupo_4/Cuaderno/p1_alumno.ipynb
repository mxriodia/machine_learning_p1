    "\n",
    "def dendrograma_con_miniaturas(Z, ficheros, K=None, titulo=None, lado=40):\n",
    "    \"\"\"Dendrograma de la matriz de enlace Z (scipy) con las miniaturas bajo las hojas.\n",
    "    Si se da K, dibuja la línea de corte que deja exactamente K grupos.\"\"\"\n",
    "    ficheros = list(ficheros); n = len(ficheros)\n",
    "    fig, ax = plt.subplots(figsize=(max(12, 0.3 * n), 5.5))\n",
    "    dn = dendrogram(Z, ax=ax, no_labels=True, color_threshold=0, above_threshold_color=\"#1f3b73\")\n",
    "    for x, hoja in zip(np.arange(5, 10 * n, 10), dn[\"leaves\"]):\n",
