    "# --- El sello no supervisado, comprobado de forma automática ----------------\n",
    "# Lee el JSON del cuaderno y comprueba:\n",
    "#   1. los dos encabezados de congelación existen, exactamente una vez cada uno;\n",
    "#   2. la congelación de K-means precede a la del aglomerativo;\n",
    "#   3. el primer acceso EJECUTABLE a los metadatos ocurre después de la segunda.\n",
    "# Solo cuentan como congelación los ENCABEZADOS Markdown, y solo las celdas de CÓDIGO\n",
    "# cuentan como acceso: el sello trata de lo que se ejecutó, no de lo que se escribió.\n",
    "CONGELA_KM = \"DECISIÓN CONGELADA — K-MEANS\"\n",
    "CONGELA_AG = \"DECISIÓN CONGELADA — AGLOMERATIVO\"\n",
    "\n",
    "# todas las vías ejecutables hacia los metadatos\n",
    "PATRON_META = re.compile(\n",
    "    r\"METADATOS_FILE|cargar_metadatos|metadatos\\.csv|y_autor|y_epoca|\"\n",
    "    r\"adjusted_rand_score|adjusted_mutual_info_score|\"\n",
    "    r\"\"\"\\[\\s*['\"](autor|epoca|tecnica|titulo|anio|aic_id)['\"]\\s*\\]\"\"\")\n",
    "\n",
    "\n",
    "def check_seal(ruta_cuaderno, verbose=True):\n",
    "    nb = json.load(open(ruta_cuaderno, encoding=\"utf-8\"))\n",
    "    celdas = nb[\"cells\"]\n",
    "    src = [\"\".join(c[\"source\"]) for c in celdas]\n",
    "\n",
    "    def encabezado(texto):\n",
    "        pat = re.compile(r\"^\\s*#{1,6}\\s*\" + re.escape(texto) + r\"\\s*$\", re.M)\n",
    "        return [i for i, s in enumerate(src)\n",
    "                if celdas[i][\"cell_type\"] == \"markdown\" and pat.search(s)]\n",
    "\n",
    "    km, ag = encabezado(CONGELA_KM), encabezado(CONGELA_AG)\n",
    "    if len(km) != 1:\n",
    "        raise AssertionError(f\"se esperaba exactamente un encabezado `{CONGELA_KM}`, hay {len(km)}\")\n",
    "    if len(ag) != 1:\n",
    "        raise AssertionError(f\"se esperaba exactamente un encabezado `{CONGELA_AG}`, hay {len(ag)}\")\n",
    "    km_en, ag_en = km[0], ag[0]\n",
    "    if not km_en < ag_en:\n",
    "        raise AssertionError(f\"SELLO ROTO: la congelación de K-means (celda {km_en}) debe ir \"\n",
    "                             f\"antes que la del aglomerativo (celda {ag_en})\")\n",
    "    usos = [i for i, s in enumerate(src)\n",
    "            if celdas[i][\"cell_type\"] == \"code\" and PATRON_META.search(s)\n",
    "            and \"def check_seal\" not in s and \"PATRON_META\" not in s]\n",
    "    primero = min(usos) if usos else len(celdas)\n",
    "    if verbose:\n",
    "        print(f\"{CONGELA_KM:38s} -> celda {km_en}\")\n",
    "        print(f\"{CONGELA_AG:38s} -> celda {ag_en}\")\n",
    "        print(f\"{'primer acceso ejecutable a metadatos':38s} -> celda {primero}\")\n",
    "    if primero <= ag_en:\n",
    "        raise AssertionError(f\"SELLO ROTO: la celda de código {primero} accede a los metadatos \"\n",
    "                             f\"antes de la congelación del aglomerativo (celda {ag_en})\")\n",
    "    if verbose:\n",
    "        print(\"SELLO CORRECTO: las dos configuraciones se congelaron antes de leer ningún metadato.\")\n",
    "    return km_en, ag_en, primero"
   ]
