    "# Se abre AQUÍ, dentro de la revelación, y en ningún sitio antes.\n",
    "METADATOS_FILE = os.path.join(DATOS, \"metadatos.csv\")\n",
    "\n",
    "\n",
    "def cargar_metadatos(cuadros, path=None):\n",
    "    \"\"\"metadatos.csv: row_id, autor, epoca, anio, tecnica, titulo, tecnica_original, aic_id.\n",
    "    Se alinea por row_id con la tabla de cuadros, nunca por posición.\"\"\"\n",
    "    meta = pd.read_csv(path or METADATOS_FILE)\n",
    "    m = cuadros[[\"row_id\"]].merge(meta, on=\"row_id\", how=\"left\", validate=\"1:1\")\n",
    "    assert m[\"autor\"].notna().all(), \"hay un cuadro sin metadatos\"\n",
    "    assert (m[\"row_id\"].to_numpy() == cuadros[\"row_id\"].to_numpy()).all()\n",
    "    return m"
