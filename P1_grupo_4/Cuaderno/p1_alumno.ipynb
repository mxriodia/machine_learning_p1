    "n = H.shape[0]  \n",
    "Z_enlaces = {}\n",
    "\n",
    "\n",
    "for enlace in ENLACES:                                          \n",
    "    Z_enlaces[enlace] = scipy_linkage(H, method=enlace, metric='euclidean')\n",
    "\n",
    "\n",
    "\n",
    "for k in range(3,9):\n",
    "    silueta_modelos =[]\n",
    "    tamanos_aglomerative_modelos = []\n",
    "    salto_entre_enlace = []\n",
    "    saltos_modelos = []                                         \n",
    "    for enlace in ENLACES: \n",
    "        modelo_aglomerativo = AgglomerativeClustering(n_clusters=k,metric = 'euclidean',linkage= enlace)\n",
    "        modelo_aglomerativo.fit_predict(H)\n",
    "        modelos_aglomerativos[enlace] = modelo_aglomerativo\n",
    "        modelo_actual = modelos_aglomerativos[enlace]\n",
    "        silueta_modelos.append(silhouette_score(H, modelo_actual.labels_))\n",
    "        tamanos_aglomerative_modelos.append(np.bincount(modelo_actual.labels_).tolist())\n",
    "        # calcular alturas de fusión\n",
    "        h = Z_enlaces[enlace][:, 2]                             \n",
    "        saltos_modelos.append(h[n - k] / h[n - k - 1])\n",
    "        \n",
    "\n",
