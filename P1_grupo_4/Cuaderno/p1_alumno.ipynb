    "        im = Image.open(os.path.join(CUADROS_DIR, fichero)).convert(\"RGB\")\n",
    "        im.thumbnail((lado, lado))\n",
    "        _MINI[clave] = np.asarray(im)\n",
    "    return _MINI[clave]\n",
    "\n",
    "\n",
    "def rejilla_miniaturas(ficheros, grupos, titulo=None, lado=70, rotulos=None):\n",
    "    \"\"\"Una fila por grupo, con las miniaturas de sus cuadros.\n",
    "    rotulos (opcional): un texto por cuadro, que se escribe encima de su miniatura.\"\"\"\n",
    "    ficheros, grupos = list(ficheros), np.asarray(grupos)\n",
