    "def cargar_cuadros(path=CUADROS_FILE):\n",
    "    \"\"\"Tabla de cuadros: row_id, fichero, ancho, alto. No contiene autor ni ningún metadato.\"\"\"\n",
    "    tab = pd.read_csv(path)\n",
    "    assert list(tab.columns) == [\"row_id\", \"fichero\", \"ancho\", \"alto\"], list(tab.columns)\n",
    "    return tab\n",
    "\n",
    "\n",
    "def cargar_imagen(fichero):\n",
    "    \"\"\"Devuelve el cuadro como array uint8 de forma (alto, ancho, 3).\"\"\"\n",
    "    return np.asarray(Image.open(os.path.join(CUADROS_DIR, fichero)).convert(\"RGB\"))\n",
    "\n",
    "\n",
    "def a_pixeles(img):\n",
    "    \"\"\"Imagen (alto, ancho, 3) en uint8 -> matriz (número de píxeles, 3) en [0, 1].\"\"\"\n",
    "    return img.reshape(-1, 3).astype(float) / 255.0\n",
    "\n",
    "\n",
    "def mostrar_paleta(ax, colores, proporciones):\n",
    "    \"\"\"Tira horizontal con los colores ordenados de mayor a menor proporción.\"\"\"\n",
    "    colores, proporciones = np.asarray(colores), np.asarray(proporciones, float)\n",
    "    orden = np.argsort(-proporciones)\n",
    "    izq = 0.0\n",
    "    for c, p in zip(colores[orden], proporciones[orden] / proporciones.sum()):\n",
    "        ax.barh(0, p, left=izq, color=np.clip(c, 0, 1), height=1.0)\n",
    "        izq += p\n",
    "    ax.set_xlim(0, 1); ax.set_ylim(-0.5, 0.5); ax.axis(\"off\")\n",
    "\n",
    "\n",
    "def rand_ajustado(a, b):\n",
    "    \"\"\"Índice de Rand ajustado entre DOS PARTICIONES vuestras (Tema 2), calculado a partir de la\n",
    "    tabla de contingencia. Sirve para comparar particiones entre sí en los Ejercicios 1-4; la\n",
    "    función equivalente de scikit-learn queda reservada a la revelación (el sello la vigila).\"\"\"\n",
    "    _, ia = np.unique(a, return_inverse=True); _, ib = np.unique(b, return_inverse=True)\n",
    "    T = np.zeros((ia.max() + 1, ib.max() + 1)); np.add.at(T, (ia, ib), 1)\n",
    "    c2 = lambda x: x * (x - 1) / 2\n",
    "    s, sa, sb, N = c2(T).sum(), c2(T.sum(1)).sum(), c2(T.sum(0)).sum(), c2(len(a))\n",
    "    esperado = sa * sb / N\n",
    "    return float((s - esperado) / (0.5 * (sa + sb) - esperado))\n",
    "\n",
    "\n",
    "def comprobar_estimador(est, X):\n",
    "    \"\"\"Comprobaciones mínimas de que `est` es un estimador de agrupamiento de scikit-learn.\n",
    "    No sustituye a sklearn.utils.estimator_checks.check_estimator, que podéis investigar.\"\"\"\n",
    "    from sklearn.base import BaseEstimator, ClusterMixin, clone\n",
    "    X = np.asarray(X, dtype=float)\n",
    "    res = []\n",
    "    def ok(nombre, cond):\n",
    "        res.append((nombre, bool(cond)))\n",
    "    ok(\"hereda de BaseEstimator\", isinstance(est, BaseEstimator))\n",
    "    ok(\"hereda de ClusterMixin\", isinstance(est, ClusterMixin))\n",
    "    ok(\"clone() conserva los parámetros\", clone(est).get_params() == est.get_params())\n",
    "    e1 = clone(est)\n",
    "    ok(\"fit devuelve el propio estimador\", e1.fit(X) is e1)\n",
    "    ok(\"labels_ con una etiqueta por patrón\", hasattr(e1, \"labels_\") and np.shape(e1.labels_) == (len(X),))\n",
    "    ok(\"n_iter_ existe\", hasattr(e1, \"n_iter_\"))\n",
    "    ok(\"fit_predict coincide con labels_ de fit\",\n",
    "       np.array_equal(clone(est).fit_predict(X), e1.labels_))\n",
    "    if hasattr(e1, \"predict\"):\n",
    "        ok(\"predict sobre los datos de ajuste reproduce labels_\", np.array_equal(e1.predict(X), e1.labels_))\n",
    "    ok(\"dos ajustes con los mismos parámetros dan lo mismo\", np.array_equal(clone(est).fit(X).labels_, e1.labels_))\n",
    "    for nombre, c in res:\n",
    "        print(f\"  [{'OK' if c else 'FALLA'}] {nombre}\")\n",
    "    print(\"TODO CORRECTO\" if all(c for _, c in res) else \"HAY COMPROBACIONES QUE FALLAN\")\n",
    "    return all(c for _, c in res)\n",
    "\n",
    "\n",
    "_MINI = {}\n",
    "def _miniatura(fichero, lado):\n",
