   "source": [
    "from sklearn.metrics import silhouette_score\n",
    "MODELOS = []\n",
    "K_GRID = list(range(3, 9))\n",
    "for k in K_GRID:\n",
    "    js_modelos = []\n",
    "    silueta_modelos =[]\n",
    "    silueta_modelos_l1 =[]\n",
    "    tamanos_kmeans_modelos = []\n",
    "    for semilla in P1_SEEDS: \n",
    "        modelo_kmeans1 = KMeans(n_clusters=k,n_init = 1,random_state = semilla) \n",
    "        modelo_kmeans1.fit(H)\n",
    "        labels = modelo_kmeans1.predict(H)\n",
    "        js_modelos.append(modelo_kmeans1.inertia_)\n",
    "        silueta_modelos.append(silhouette_score(H, labels))\n",
    "        silueta_modelos_l1.append(silhouette_score(H, labels,metric='manhattan'))\n",
    "        tamanos_kmeans_modelos.append(np.bincount(labels).tolist())\n",
    "    media_J_modelos = np.mean(js_modelos)\n",
    "    std_J_modelos = np.std(js_modelos)\n",
    "    js_modelos_personal = []\n",
    "    silueta_modelos_personal =[]\n",
    "    tamanos_kmeans_modelos_personal = []\n",
    "    modelo_personal = MiVariante(n_clusters = k)\n",
    "    modelo_personal.fit(H)\n",
    "    labels = modelo_personal.predict(H)\n",
    "    js_modelos_personal.append(modelo_personal.inertia_)\n",
    "    silueta_modelos_personal.append(silhouette_score(H,labels)) \n",
    "    silueta_modelos_personal.append(silhouette_score(H,labels,metric='manhattan'))\n",
    "    tamanos_kmeans_modelos_personal.append(np.bincount(labels).tolist())\n",
    "    MODELOS.append({\n",
    "        \"K\": k,\n",
    "        \"KMeans: J (Media)\": media_J_modelos,\n",
    "        \"KMeans: J (Dispersión)\": std_J_modelos,\n",
