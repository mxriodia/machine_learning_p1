    "from sklearn.base import BaseEstimator, ClusterMixin, TransformerMixin\n",
    "from sklearn.cluster import KMeans\n",
    "\n",
    "class MiVariante(ClusterMixin, BaseEstimator):    \n",
    "    \"\"\"TODO: qué hace la variante.\"\"\"\n",
    "    def __init__(self, n_clusters=8,pesos = None, max_iter = 100):\n",
    "\n",
    "        self.n_clusters = n_clusters\n",
    "        #self.w_R = pesos[0]\n",
    "        #self.w_G = pesos[1]\n",
    "        #self.w_B = pesos[2]\n",
    "        self.pesos = pesos\n",
    "        self.max_iter = max_iter\n",
    "\n",
    "    def fit(self, X, y=None):\n",
    "        n_columnas = X.shape[1]\n",
    "        # 1. Asignación de pesos si no se asignó ningún valor\n",
    "        if self.pesos is None:\n",
    "            self.pesos = np.full(n_columnas, 1.0 / n_columnas)\n",
    "        else:\n",
    "            self.pesos = np.array(self.pesos)\n",
    "        \n",
    "    # 2.Vemos que el número de pesos es igual al número de columnas \n",
    "        if len(self.pesos) != n_columnas:\n",
    "            raise ValueError(f\"Se esperaban {n_columnas} pesos, pero se recibieron {len(self.pesos)}.\")\n",
    "        #w_R = self.pesos[0]\n",
    "        #w_G = self.pesos[1]\n",
    "        #w_B = self.pesos[2]\n",
    "    # 3. Comprobamos que sumen 1 o estén cerca de sumar 1 los pesos\n",
    "        if not np.isclose(np.sum(self.pesos), 1.0):\n",
    "            raise ValueError(\"La suma de los pesos debe ser igual a 1.\")\n",
    "        #if not (w_R + w_G + w_B == 1):\n",
    "         #   raise ValueError(\"La suma de los pesos debe ser igual a 1.\")\n",
    "        #Calcular los centroides iniciales de forma determinista.\n",
    "        m_0 = np.full(n_columnas, 0.5)\n",
    "        m_1 = X[np.argmax(np.linalg.norm(X - m_0, axis=1, ord = 1))]\n",
    "        m_2 = X[np.argmax(np.min(np.linalg.norm(X[:, np.newaxis] - np.array([m_0, m_1]),ord = 1,axis=2), axis=1))]\n",
    "        m = np.zeros((self.n_clusters, n_columnas))\n",
    "        m[0] = m_1\n",
    "        m[1] = m_2\n",
    "        if self.n_clusters > 2:\n",
    "                for i in range(2, self.n_clusters):\n",
    "                       m[i] = X[np.argmax(np.min(np.linalg.norm(X[:, np.newaxis] - m[:i], ord = 1,axis=2), axis=1))]\n",
    "        n_iter = 0\n",
    "        \n",
    "        #Algoritmo pasos iterativos:\n",
    "        js = []\n",
    "        for iter in range(self.max_iter):\n",
    "             #Paso 1: Calcular distancia de cada patron a cada centroide.\n",
    "            distancias = np.zeros((X.shape[0], self.n_clusters))\n",
    "            #Paso 2: Agrupamos los patrones en el cluster del centroide más cercano\n",
    "            for r in range(self.n_clusters):\n",
    "                 #distancias[:, r] = w_R * np.abs(X[:, 0] - m[r, 0]) + w_G * np.abs(X[:, 1] - m[r, 1]) + w_B * np.abs(X[:, 2] - m[r, 2])\n",
    "                  distancias[:, r] = np.sum(self.pesos * np.abs(X - m[r]), axis=1)\n",
    "            #Labels te devuelve un array de tamaño del numero de patrones, donde cada elemento es el índice del cluster al que pertenece el patrón. \n",
    "            labels = np.argmin(distancias, axis=1)\n",
    "            j_actual = np.sum(distancias[np.arange(X.shape[0]), labels])\n",
    "            js.append(j_actual)\n",
    "            #Paso 3: Recalcular centroide de cada cluster C_r, tomando la mediana de cada variable.\n",
    "            m_nuevo = np.zeros((self.n_clusters, n_columnas))\n",
    "            \n",
    "            for r in range(self.n_clusters):\n",
    "                # m_nuevo[r] = np.median(X[labels == r], axis=0)\n",
    "                # if m_nuevo[r] is None:\n",
    "                #  m_nuevo[r] = m[r]\n",
    "                cluster_pts = X[labels == r]\n",
    "                if len(cluster_pts) > 0:\n",
    "                    m_nuevo[r] = np.median(cluster_pts, axis=0)\n",
    "                else:\n",
    "                    m_nuevo[r] = m[r]  # Si está vacío, conservamos el centroide anterior\n",
    "            \n",
    "            #Paso 4: Repetir los pasos 1 a 3 hasta que los pixeles no cambien de grupo\n",
    "            for r in range(self.n_clusters):\n",
    "                 #distancias[:, r] = w_R * np.abs(X[:, 0] - m_nuevo[r, 0]) + w_G * np.abs(X[:, 1] - m_nuevo[r, 1]) + w_B * np.abs(X[:, 2] - m_nuevo[r, 2])\n",
    "                 distancias[:, r] = np.sum(self.pesos * np.abs(X - m_nuevo[r]), axis=1)\n",
    "            new_labels = np.argmin(distancias, axis=1)\n",
    "            if np.array_equal(new_labels,labels):\n",
    "                m = m_nuevo\n",
    "                n_iter = iter\n",
    "                break\n",
    "            m = m_nuevo\n",
    "        self.inertia_ = js[-1]   \n",
    "        self.n_iter_ = n_iter\n",
    "        self.cluster_centers_ = m_nuevo\n",
    "        self.labels_ = new_labels\n",
    "        self.historial_j = js\n",
    "        return self\n",
    "\n",
    "    def predict(self, X):\n",
    "         #w_R = self.pesos[0]\n",
